# =============================================================================
# LcTTSHub —— Git 忽略规则
# 目标：只提交源码与配置，不上传虚拟环境、模型权重、生成产物与缓存。
# =============================================================================

# ----------------------------- Node / 前端 ----------------------------------
# tts 管家控制台（frontend/）的依赖；构建产物 tts_hub/static/ 需入库，勿忽略
node_modules/
frontend/dist/
frontend/.vite/

# ----------------------------- Python 缓存 / 编译产物 ------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----------------------------- 虚拟环境 --------------------------------------
# 项目自带的两个 Python 3.12 虚拟环境（体积巨大，按机器重建）
py312env/
index25env/
breezeenv/
.venv/
venv/
env/

# 注意：packages/ 目录【故意不忽略】，它被纳入 git。
# 原因：Audio8 / Confucius4-TTS / IndexTTS-2.5 运行时通过 sys.path 优先加载
# packages/index25 下的补丁版 transformers==4.52.1 / tokenizers==0.21.4 /
# huggingface_hub==0.36.2，缺失会导致这些引擎生成异常。请勿 gitignore 它。

# ----------------------------- 模型权重 / 下载缓存 ---------------------------
# 模型权重按需下载（tools/models_manager.py 自动拉取），不入库。
models/
# HuggingFace 下载缓存（含已下载的模型权重），不入库
hf_download/hub/
hf_download/*.incomplete

# ----------------------------- 运行产物 / 用户上传 ----------------------------
outputs/
uploads/

# ----------------------------- 预编译 wheel（体积大，另行分发，不入库）--------
whl/*.whl

# ----------------------------- 通用：产物 / 缓存 / 日志目录（任意层级）--------
# outputs/ 无前导斜杠，匹配任意层级的 outputs 目录（各引擎运行产物）
outputs/
# 注意：不要写 caches/，会误伤 packages/index25/pip/_vendor/cachecontrol/caches 源码
cache/
logs/
results/
generated/
*.cache

# ----------------------------- 测试 / 临时产物 ------------------------------
voxcpm_repeat/
voxcpm_test.wav

# ----------------------------- 临时 / 日志 / 归档 ----------------------------
tmp/
# TTS API 管家的运行期配置覆盖层（机器本地状态，由 PUT /api/hub/*/config 生成）
config/tts_hub.overrides.yaml
*.log
*.err
*.7z
*.zip

# ----------------------------- 编辑器 / 代理数据 -----------------------------
.codebuddy/
.trae/
.vscode/
.idea/

# ----------------------------- 第三方 agent 元数据 / 大二进制 -----------------
# IDE/agent 运行时自动生成的 harness 清单，非项目源码（勿入库）
.agent_harnesses.json
# 第三方安装包（体积大，另行分发，不入库）
*.exe
